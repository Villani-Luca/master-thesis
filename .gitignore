# OSX
.DS_Store
.Spotlight-V100
.Trashes
._*

# Python byte-compiled / optimized / DLL
__pycache__/
*.py[cod]
*$py.class

# Python environment
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Python packaging (pip install -e code) and tooling
*.egg-info/
.pytest_cache/

# Latex build outputs
latex-thesis/*.synctex.*
latex-thesis/main.pdf
latex-thesis/main.aux
latex-thesis/main.lof
latex-thesis/main.lol
latex-thesis/main.out
latex-thesis/main.bcf
latex-thesis/main.run.xml
latex-thesis/main.blg
latex-thesis/main.bbl
latex-thesis/main.fdb_latexmk
latex-thesis/main.fls
latex-thesis/main.log
latex-thesis/main.toc

# Local datasets
code/data/

# Large attribution tensors (global.parquet and metrics stay in git)
code/results/xai/**/attributions*.npz
code/results/xai/**/weights.npz
code/results/xai_sampled_dates/**/attributions*.npz
code/results/xai_sampled_dates/**/weights.npz

# Training and portfolio outputs: the large files stay local and are kept on a separate drive
# (checkpoints, results pickles, predictions, holdings); the small ones (config.json, metrics.json,
# train_history.csv, returns.csv.gz, the analysis tables) are tracked.
code/results/**/*.pth
code/results/**/*.pkl
code/results/**/predictions.csv.gz
code/results/portfolio/**/*.parquet
code/results/portfolio/**/holdings.csv.gz


# Half-trained runs (deleted when the run finishes)
code/results/Regression/**/resume.pt
code/results/Regression/**/resume.tmp

# Logs of grid.py run
logs/
